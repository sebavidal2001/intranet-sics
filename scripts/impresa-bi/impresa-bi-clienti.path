[Unit]
Description=Monitora i run "clienti" pronti per l'ingest

[Path]
# Directory distinta da ready/ e ready-cruscotto/: ogni profilo sveglia solo
# il proprio servizio.
PathChanged=/var/lib/impresa-bi/ready-clienti
DirectoryNotEmpty=/var/lib/impresa-bi/ready-clienti
Unit=impresa-bi-clienti.service

[Install]
WantedBy=multi-user.target
