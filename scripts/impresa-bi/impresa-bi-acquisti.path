[Unit]
Description=Monitora i run "acquisti" pronti per l'ingest

[Path]
# Directory distinta da ready/ e ready-cruscotto/: ogni profilo sveglia solo
# il proprio servizio.
PathChanged=/var/lib/impresa-bi/ready-acquisti
DirectoryNotEmpty=/var/lib/impresa-bi/ready-acquisti
Unit=impresa-bi-acquisti.service

[Install]
WantedBy=multi-user.target
