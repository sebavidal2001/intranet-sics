[Unit]
Description=Impresa BI — ingest dell'anagrafica clienti
After=network-online.target impresa-bi-ingest.service
Wants=network-online.target

[Service]
Type=oneshot
User=impresa-bi
Group=impresa-bi
EnvironmentFile=/etc/impresa-bi/supabase.env
Environment=BI_CLIENTI_READY=/var/lib/impresa-bi/ready-clienti
Environment=BI_CLIENTI_PROCESSED=/var/lib/impresa-bi/processed-clienti
Environment=BI_CLIENTI_FAILED=/var/lib/impresa-bi/failed-clienti
Environment=BI_CLIENTI_SCRIPT=/opt/intranet-sics/scripts/bi-ingest-clienti.mjs
Environment=HOME=/var/lib/impresa-bi
Environment=NODE_OPTIONS=--max-old-space-size=1024
WorkingDirectory=/var/lib/impresa-bi
ExecStart=/opt/impresa-bi/clienti-ingest.sh
TimeoutStartSec=30min
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/impresa-bi
RestrictAddressFamilies=AF_INET AF_INET6
RestrictRealtime=true
